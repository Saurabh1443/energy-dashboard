# Copy this file to .env and adjust values as needed.
# .env is gitignored and must not be committed.

# --- Backend (Django) ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Optional DB path.
# - Local / Render native: leave unset (uses backend/data/db.sqlite3)
# - Docker Compose: /app/data/db.sqlite3
# DJANGO_DB_PATH=data/db.sqlite3
SKIP_SEED=false


# CORS / CSRF — production frontend target
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://uk-wind-portal.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://uk-wind-portal.vercel.app

# Host port mappings (local Docker Compose)
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Frontend (Vite / browser) ---
# Local default. On Vercel set this to your deployed API URL.
VITE_API_BASE_URL=http://localhost:8000
